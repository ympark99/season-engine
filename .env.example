# Vercel → Project → Settings → Environment Variables 에 넣을 값 (이 파일엔 실제 값 넣지 말 것)
KIS_APP_KEY=
KIS_APP_SECRET=
# 아무 긴 랜덤 문자열 — 사이트 [관리자 키]에 같은 값 입력
ADMIN_TOKEN=
# 아무 긴 랜덤 문자열 — Vercel Cron 인증용 (사이트에 입력할 일 없음)
CRON_SECRET=
# UPSTASH_REDIS_REST_URL / _TOKEN (또는 KV_REST_API_URL / _TOKEN) 은 Upstash 연동 시 자동으로 들어감
