{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": { "api/*.js": { "maxDuration": 300 } },
  "rewrites": [
    { "source": "/api/add", "destination": "/api/list?op=add" },
    { "source": "/api/remove", "destination": "/api/list?op=remove" },
    { "source": "/api/meta", "destination": "/api/cron?op=meta" },
    { "source": "/api/health", "destination": "/api/cron?op=health" }
  ],
  "crons": [
    { "path": "/api/cron?m=KR", "schedule": "10 7 * * 1-5" },
    { "path": "/api/cron?op=step&m=KR&bk=1", "schedule": "20 7 * * 1-5" },
    { "path": "/api/cron?op=step&m=KR&bk=2", "schedule": "30 7 * * 1-5" },
    { "path": "/api/cron?op=step&m=KR&bk=3", "schedule": "40 7 * * 1-5" },
    { "path": "/api/cron?op=step&m=KR&bk=4", "schedule": "50 7 * * 1-5" },
    { "path": "/api/cron?op=step&m=KR&bk=5", "schedule": "5 8 * * 1-5" },
    { "path": "/api/cron?op=step&m=KR&bk=6", "schedule": "20 8 * * 1-5" },
    { "path": "/api/cron?op=step&m=KR&bk=7", "schedule": "35 8 * * 1-5" },
    { "path": "/api/cron?op=step&m=KR&bk=8", "schedule": "50 8 * * 1-5" },
    { "path": "/api/cron?op=step&m=KR&bk=9", "schedule": "20 9 * * 1-5" },
    { "path": "/api/cron?op=step&m=KR&bk=10", "schedule": "50 9 * * 1-5" },
    { "path": "/api/cron?op=step&m=KR&bk=11", "schedule": "30 10 * * 1-5" },
    { "path": "/api/cron?op=step&m=KR&bk=12", "schedule": "30 11 * * 1-5" },
    { "path": "/api/cron?op=step&m=KR&bk=13", "schedule": "30 12 * * 1-5" },
    { "path": "/api/cron?op=step&m=KR&bk=14", "schedule": "30 13 * * 1-5" },
    { "path": "/api/cron?m=US", "schedule": "10 21 * * 1-5" },
    { "path": "/api/cron?op=step&m=US&bk=1", "schedule": "20 21 * * 1-5" },
    { "path": "/api/cron?op=step&m=US&bk=2", "schedule": "30 21 * * 1-5" },
    { "path": "/api/cron?op=step&m=US&bk=3", "schedule": "40 21 * * 1-5" },
    { "path": "/api/cron?op=step&m=US&bk=4", "schedule": "50 21 * * 1-5" },
    { "path": "/api/cron?op=step&m=US&bk=5", "schedule": "55 21 * * 1-5" },
    { "path": "/api/cron?op=step&m=US&bk=6", "schedule": "5 22 * * 1-5" },
    { "path": "/api/cron?op=step&m=US&bk=7", "schedule": "15 22 * * 1-5" },
    { "path": "/api/cron?op=step&m=US&bk=8", "schedule": "25 22 * * 1-5" },
    { "path": "/api/cron?op=step&m=US&bk=9", "schedule": "35 22 * * 1-5" },
    { "path": "/api/cron?op=step&m=US&bk=10", "schedule": "45 22 * * 1-5" },
    { "path": "/api/cron?op=step&m=US&bk=11", "schedule": "55 22 * * 1-5" },
    { "path": "/api/cron?op=step&m=US&bk=12", "schedule": "15 23 * * 1-5" },
    { "path": "/api/cron?op=step&m=US&bk=13", "schedule": "45 23 * * 1-5" },
    { "path": "/api/cron?op=step&m=US&bk=14", "schedule": "15 0 * * 2-6" },
    { "path": "/api/cron?op=step&m=US&bk=15", "schedule": "45 0 * * 2-6" },
    { "path": "/api/cron?op=step&m=US&bk=16", "schedule": "30 1 * * 2-6" },
    { "path": "/api/cron?op=step&m=US&bk=17", "schedule": "30 2 * * 2-6" },
    { "path": "/api/cron?op=step&m=US&bk=18", "schedule": "30 3 * * 2-6" }
  ]
}
